

#include <LiquidCrystal.h>
LiquidCrystal lcd_1(12, 11, 5, 4, 3, 2);
int sensorPin = A0;
float temperature;

void setup()
{
  lcd_1.begin(16, 2);
  lcd_1.print("Temperature:");
}

void loop()
{
  int reading = analogRead(sensorPin);
  float voltage = reading * (5.0 / 1023.0);
  temperature = voltage * 100; // LM35 scale
  lcd_1.setCursor(0, 1);
  lcd_1.print(temperature);
  lcd_1.print(" C "); // spaces clear old digits
  delay(1000);
}
